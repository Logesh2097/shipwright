# Copy to .env and adjust. Used by docker compose and by the backend.

ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=asea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asea
# Host port for the database container (5432 is often taken by a local PostgreSQL)
POSTGRES_HOST_PORT=55432
# Used when running the backend outside Docker
DATABASE_URL=postgresql+psycopg://asea:change-me@localhost:55432/asea

# --- Secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
APPROVAL_TOKEN_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Access ---
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Repositories ---
# Host directory that contains the repositories you want to register
REPOS_HOST_DIR=/path/to/your/repositories
# Comma-separated directories (as seen by the backend process) that repositories may be
# registered from. In docker compose the host directory above is mounted at /repos.
REPOS_ALLOWED_ROOTS=/repos

# --- Sandbox ---
# auto = docker when reachable, otherwise local. "local" gives no network or filesystem isolation.
SANDBOX_MODE=auto
SANDBOX_IMAGE=asea-sandbox:latest
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
# Group id of the Docker socket on the host (stat -c %g /var/run/docker.sock)
DOCKER_GID=999
# User and group that own REPOS_HOST_DIR (id -u, id -g); the backend container runs as this user
HOST_UID=1000
HOST_GID=1000

# --- LLM (agent runs fail with llm_not_configured until a key and a model are set) ---
# openai: uses OPENAI_API_KEY (and OPENAI_BASE_URL for an OpenAI-compatible service).
# gemini: uses GEMINI_API_KEY with Google's native API. Do not point OPENAI_BASE_URL at
#         Gemini's OpenAI-compatible endpoint: multi-step tool calls fail there.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model name your account has, for example a GPT model for openai or a gemini-* model for gemini
LLM_MODEL=
# OPENAI_BASE_URL=
# Client-side pacing; 0 = off. Set just below your requests-per-minute quota
# (for example 12 on Gemini's free tier, which allows 15).
LLM_REQUESTS_PER_MINUTE=0

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
